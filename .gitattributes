# Normalizar archivos de texto para trabajar desde Windows y otros sistemas.
* text=auto
*.md text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Documentos y recursos binarios se conservan sin conversión.
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
