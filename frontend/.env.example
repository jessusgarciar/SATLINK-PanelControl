# Browser-visible values only. Never add MQTT, database or ChirpStack credentials.
VITE_DATA_SOURCE=demo
VITE_API_BASE_URL=/api/v1
VITE_MISSION_ID=satlink-001
# Development proxy target. Not exposed to the browser.
SATLINK_BACKEND_ORIGIN=http://127.0.0.1:8000
# Optional tile provider. Empty URL disables basemap requests.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
